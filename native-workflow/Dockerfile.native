# This runtime image contains only the verified native executable so deployment stays small while provenance remains in the build manifest.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}

ARG RELEASE_VERSION
ARG SCHEMA_REVISION
LABEL org.opencontainers.image.version="${RELEASE_VERSION}" \
      org.opencontainers.image.revision="${SCHEMA_REVISION}"

COPY --chown=10001:0 schema-registry /usr/local/bin/schema-registry
RUN mkdir -p /opt/app

USER 10001
ENTRYPOINT ["/usr/local/bin/schema-registry"]
CMD ["/etc/schema-registry.properties"]
