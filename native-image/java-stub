check_port_connectivity() {
    local hostname="$1"
    local port="$2"
    local timeout=3

    # Check if both hostname and port are provided
    if [ -z "$hostname" ] || [ -z "$port" ]; then
        echo "Usage: check_port_connectivity <hostname> <port>"
        return 1
    fi

    # Use the /dev/tcp file descriptor redirection
    if timeout $timeout bash -c "</dev/tcp/${hostname}/${port}" 2>/dev/null; then
        echo "SUCCESS: Host '$hostname' is reachable on port $port."
        return 0
    else
        echo "FAILURE: Host '$hostname' is NOT reachable on port $port (or port is closed)."
        return 1
    fi
}

check_for_substring() {
    local substring="$1"
    local found_arg=""

    if [ -z "$substring" ]; then
        echo "Error: Please provide the substring you want to search for."
        return 1
    fi

    # Iterate over all arguments passed to the script/function
    for arg in "$@"; do
        # Bash's [[ $arg =~ $substring ]] uses regex matching.
        # This is the most robust way to check for substring presence.
        if [[ "$arg" =~ $substring ]]; then
            found_arg="$arg"
            echo "SUCCESS: The substring \"$substring\" was found in argument: \"$found_arg\""
            return 0 # Exit immediately upon finding the first match
        fi
    done

    # If the loop finishes without finding a match
    echo "FAILURE: The substring \"$substring\" was not found in any of the provided arguments."
    return 1
}



